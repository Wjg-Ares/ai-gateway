AI_GATEWAY_API_KEY='replace-with-a-long-random-gateway-key'
DEEPSEEK_API_KEY='replace-with-your-deepseek-api-key'

# Optional PostgreSQL mode. Leave unset to keep using JSON routes and the
# static gateway key while the database migration is being rolled out.
# AI_GATEWAY_DATABASE_URL='postgres://ai_gateway_app:password@127.0.0.1:5432/ai_gateway?sslmode=disable'
# Admin panel key. Keep this different from the client gateway key.
# AI_GATEWAY_ADMIN_KEY='replace-with-a-long-random-admin-key'
# Admin login password for the built-in admin account (username: admin).
# AI_GATEWAY_ADMIN_PASSWORD='replace-with-a-long-admin-password'
# Used to encrypt provider keys entered in /admin/ before storing them in PostgreSQL.
# AI_GATEWAY_KEY_ENCRYPTION_SECRET='replace-with-a-long-random-encryption-secret'
# Optional OpenAI-compatible provider environment keys:
# VOLCENGINE_ARK_API_KEY='your-ark-key'
# KIMI_API_KEY='your-kimi-key'
# OPENAI_API_KEY='your-openai-api-key'

{
  "listen_addr": "127.0.0.1:19527",
  "gateway_api_key_env": "AI_GATEWAY_API_KEY",
  "models": {
    "claude-team": {
      "provider": "anthropic-direct",
      "upstream_model": "claude-model-name"
    },
    "deepseek-team": {
      "provider": "deepseek",
      "upstream_model": "deepseek-flash"
    },
    "volcengine-team": {
      "provider": "volcengine",
      "upstream_model": "volcengine-model-name"
    },
    "kimi-team": {
      "provider": "kimi",
      "upstream_model": "kimi-model-name"
    },
    "gpt-team": {
      "provider": "openai-direct",
      "upstream_model": "openai-model-name"
    },
    "gemini-team": {
      "provider": "gemini-direct",
      "upstream_model": "gemini-model-name"
    }
  },
  "providers": {
    "anthropic-direct": {
      "protocol": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "deepseek": {
      "protocol": "anthropic",
      "base_url": "https://api.deepseek.com/anthropic",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "volcengine": {
      "protocol": "anthropic",
      "base_url": "https://example.volcengine-endpoint.invalid/anthropic",
      "api_key_env": "VOLCENGINE_API_KEY"
    },
    "kimi": {
      "protocol": "anthropic",
      "base_url": "https://example.kimi-endpoint.invalid/anthropic",
      "api_key_env": "KIMI_API_KEY"
    },
    "openai-direct": {
      "protocol": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY"
    },
    "gemini-direct": {
      "protocol": "gemini",
      "base_url": "https://generativelanguage.googleapis.com",
      "api_key_env": "GEMINI_API_KEY"
    }
  }
}

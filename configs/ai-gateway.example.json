{
  "listen_addr": "127.0.0.1:19527",
  "gateway_api_key_env": "AI_GATEWAY_API_KEY",
  "admin_api_key_env": "AI_GATEWAY_ADMIN_KEY",
  "admin_password_env": "AI_GATEWAY_ADMIN_PASSWORD",
  "database_url_env": "AI_GATEWAY_DATABASE_URL",
  "database_schema": "ai_gateway",
  "models": {
    "claude-team": {
      "provider": "anthropic-direct",
      "upstream_model": "claude-model-name"
    },
    "deepseek-team": {
      "provider": "deepseek",
      "upstream_model": "deepseek-flash"
    },
    "volcengine-team": {
      "provider": "volcengine-ark",
      "upstream_model": "ep-xxxxxxxxxxxxxxxx"
    },
    "kimi-team": {
      "provider": "kimi",
      "upstream_model": "kimi-model-name"
    },
    "gpt-team": {
      "provider": "openai-direct",
      "upstream_model": "openai-model-name",
      "max_concurrency": 1
    },
    "gemini-team": {
      "provider": "gemini-direct",
      "upstream_model": "gemini-model-name"
    }
  },
  "providers": {
    "anthropic-direct": {
      "protocol": "anthropic",
      "base_url": "https://api.anthropic.com",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "deepseek": {
      "protocol": "anthropic",
      "base_url": "https://api.deepseek.com/anthropic",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "volcengine-ark": {
      "protocol": "openai",
      "base_url": "https://ark.cn-beijing.volces.com/api/v3",
      "api_key_env": "VOLCENGINE_ARK_API_KEY"
    },
    "kimi": {
      "protocol": "openai",
      "base_url": "https://api.moonshot.cn/v1",
      "api_key_env": "KIMI_API_KEY"
    },
    "openai-direct": {
      "protocol": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY"
    },
    "gemini-direct": {
      "protocol": "gemini",
      "base_url": "https://generativelanguage.googleapis.com",
      "api_key_env": "GEMINI_API_KEY"
    }
  }
}
